DB_TESTS=dialect+driver://db_user:db_pwd@host:port/tests_db_name
#^ database used by pytest

#dialect+driver example -> postgresql+psycopg2://
#                           dialect  + driver


DATABASE_URL=dialect+driver://db_user:db_pwd@host:port/db_name
#^database used by app
#for both bases for local dev use 5433 port and localhost  for app working in container use postgres internal port 5432
# and container_service_name as host



REDIS_HOST=set_redis_host
#localhost for local dev
#container_service_name for app working in container

REDIS_PORT=set_redis_port
#port used to communicate with cache database for example 6380 for local dev, 6379 for app working in container


#DATA for docker to create postgres database, have to fit for data used in DATABASE_URL
POSTGRES_USER=set-me
POSTGRES_PASSWORD=set-me
POSTGRES_DB=set-me

SECRET_KEY=set-me
#openssl rand -hex 32

ALGORITHM=set-me
#example HS256

DUMMY_PASSWORD=set-me_example_string
#used to hash a dummy password when the user does not exist, to protect against user enumeration (timing attacks)
